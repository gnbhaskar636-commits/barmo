# BARMO environment configuration
# Copy to .env.local and fill in real values from your Supabase project dashboard:
#   https://supabase.com/dashboard/project/<your-project-ref>/settings/api
#
# These two are safe for browser use. Never use a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Legacy projects may use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-LEGACY-ANON-KEY

# Optional: Nova, the in-world AI helper (server-side only; never prefix these with NEXT_PUBLIC_)
# Without a key Nova still works using simple built-in templates.
OPENROUTER_API_KEY=
# or: ANTHROPIC_API_KEY=
# NOVA_MODEL=openai/gpt-4o-mini

# Optional: LiveKit voice for private circles (server-side only). Create a free project at https://cloud.livekit.io
# Settings -> Keys. LIVEKIT_URL looks like wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
